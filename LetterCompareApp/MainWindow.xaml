<Window x:Class="LetterCompareApp.MainWindow"

        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"

        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"

        Title="Letter Compare — Edge (left) vs Chrome preview (right)"

        Height="900" Width="1400" MinHeight="500" MinWidth="900"
        PreviewKeyDown="Window_PreviewKeyDown">

	<DockPanel>

		<Border DockPanel.Dock="Top" Background="#2d2d2d" Padding="8">

			<StackPanel>

				<WrapPanel VerticalAlignment="Center">

					<TextBlock Text="Scroll:" Foreground="White" VerticalAlignment="Center" Margin="0,0,8,0"/>

					<RadioButton x:Name="ModeBoth" Content="Both together" GroupName="scroll" IsChecked="True"

					             Foreground="White" Margin="0,0,12,0" Checked="ScrollMode_Changed"/>

					<RadioButton x:Name="ModeV5" Content="V5 / Edge only" GroupName="scroll"

					             Foreground="White" Margin="0,0,12,0" Checked="ScrollMode_Changed"/>

					<RadioButton x:Name="ModeV6" Content="V6 only" GroupName="scroll"

					             Foreground="White" Margin="0,0,12,0" Checked="ScrollMode_Changed"/>

					<RadioButton x:Name="ModeIndep" Content="Independent" GroupName="scroll"

					             Foreground="White" Margin="0,0,16,0" Checked="ScrollMode_Changed"/>

					<Button Content="▲" Width="28" Margin="0,0,4,0" Click="ScrollUp_Click"/>

					<Button Content="▼" Width="28" Margin="0,0,4,0" Click="ScrollDown_Click"/>

					<Button Content="Top" Margin="0,0,4,0" Click="ScrollTop_Click"/>

					<Button Content="Bottom" Margin="0,0,4,0" Click="ScrollBottom_Click"/>

					<Button Content="Align" Margin="0,0,12,0" Click="Align_Click"/>

					<TextBlock Text="Zoom:" Foreground="White" VerticalAlignment="Center" Margin="0,0,8,0"/>

					<Button Content="−" Width="28" Margin="0,0,4,0" Click="ZoomOut_Click"
					        ToolTip="Zoom out both panes (Ctrl + mouse wheel)"/>

					<Button Content="+" Width="28" Margin="0,0,4,0" Click="ZoomIn_Click"
					        ToolTip="Zoom in both panes (Ctrl + mouse wheel)"/>

					<Button Content="100%" Margin="0,0,12,0" Click="ZoomReset_Click" ToolTip="Reset zoom to 100%"/>

					<Button Content="Reload" Margin="0,0,8,0" Click="Reload_Click"/>

					<Button Content="Open V6 in Chrome" Margin="0,0,8,0" Click="OpenInChrome_Click"

					        ToolTip="Opens V6 in installed Google Chrome (real Chrome engine)"/>

				</WrapPanel>

				<TextBlock x:Name="StatusText" Foreground="#8bc78b" FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap"/>

			</StackPanel>

		</Border>

		<Grid>

			<Grid.ColumnDefinitions>

				<ColumnDefinition Width="*"/>

				<ColumnDefinition Width="6"/>

				<ColumnDefinition Width="*"/>

			</Grid.ColumnDefinitions>

			<DockPanel Grid.Column="0">

				<Border DockPanel.Dock="Top" Background="#1a3a5c" Padding="6">

					<TextBlock Text="LEFT — Microsoft Edge (WebView2)  ·  V5_LODI001A_IE.html"

					           Foreground="#b8d4f0" FontWeight="SemiBold" HorizontalAlignment="Center"/>

				</Border>

				<wv2:WebView2 x:Name="EdgeView" PreviewMouseWheel="WebView_PreviewMouseWheel"/>

			</DockPanel>

			<GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" Background="#444"/>

			<DockPanel Grid.Column="2">

				<Border DockPanel.Dock="Top" Background="#3a2a1a" Padding="6">

					<TextBlock Text="RIGHT — Chrome layout preview (WebView2 + Chrome user-agent)  ·  V6_LODI001A_CHROME.html"

					           Foreground="#f0d4b8" FontWeight="SemiBold" HorizontalAlignment="Center" TextWrapping="Wrap"/>

				</Border>

				<wv2:WebView2 x:Name="ChromeView" PreviewMouseWheel="WebView_PreviewMouseWheel"/>

			</DockPanel>

		</Grid>

	</DockPanel>

</Window>


